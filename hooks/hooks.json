{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "taco", "args": ["hook"], "async": true },
          { "type": "command", "command": "taco", "args": ["hook", "nudge", "--local-db", "${CLAUDE_PLUGIN_ROOT}/hooks/nudge-compat/local.db"], "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "taco", "args": ["hook", "nudge", "--local-db", "${CLAUDE_PLUGIN_ROOT}/hooks/nudge-compat/local.db"], "timeout": 5 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "taco", "args": ["hook"], "async": true }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "taco", "args": ["hook"], "async": true }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "taco", "args": ["hook"], "async": true }
        ]
      }
    ]
  }
