#!/usr/bin/env sh
# Claude Code plugin → taco MCP stdio 서버.
#
# 플러그인의 .mcp.json 이 이 스크립트를 MCP 서버 command 로 지정한다. taco CLI 를
# 견고하게 찾은 뒤(hooks 의 scripts/run 과 동일 규칙 — PATH 에 없을 수 있으므로
# 알려진 설치 경로도 탐색) `taco mcp` 로 교체 실행한다. exec 로 넘겨 이 프로세스가
# 곧 stdio JSON-RPC 서버가 되게 한다(백그라운드 아님 — 클라이언트가 stdin/stdout 로
# 계속 대화).

BIN="$(command -v taco 2>/dev/null)"
if [ -z "$BIN" ]; then
  for c in /opt/homebrew/bin/taco /usr/local/bin/taco "$HOME/.local/bin/taco"; do
    if [ -x "$c" ]; then
      BIN="$c"
      break
    fi
  done
fi
if [ -z "$BIN" ]; then
  echo "taco CLI not found (install: https://taco.inflab.com/install)" >&2
  exit 1
fi

exec "$BIN" mcp
